
configuration {
	show-icons: true;
	icon-theme: "Tela-circle-nord-dark";
	drun-display-format: "{name}";
}

@theme "default"

* {
	bg: rgba(46, 52, 64, 0.90);
	bg-alt: rgba(59, 66, 82, 0.88);
	bg-selected: rgba(94, 129, 172, 0.86);
	fg: #eceff4;
	fg-muted: #d8dee9;
	accent: #88c0d0;
	nord-red: #bf616a;
	nord-green: #a3be8c;
	border-color: #5e81ac;
}

window {
	background-color: @bg;
	border: 2px;
	border-color: @border-color;
	border-radius: 14px;
	padding: 10px;
}

mainbox {
	spacing: 8px;
}

inputbar {
	background-color: @bg-alt;
	border-radius: 10px;
	padding: 8px 10px;
	spacing: 8px;
	children: [ prompt, entry ];
}

prompt {
	text-color: @accent;
}

entry {
	text-color: @fg;
	placeholder: "Search";
}

message {
	text-color: @fg-muted;
}

listview {
	background-color: transparent;
	columns: 1;
	lines: 10;
	spacing: 4px;
	cycle: false;
	dynamic: true;
}

element {
	orientation: horizontal;
	children: [ element-icon, element-text ];
	spacing: 10px;
	padding: 8px 10px;
	border-radius: 8px;
}

element normal.normal {
	background-color: rgba(46, 52, 64, 0.95);
	text-color: @fg;
}

element normal.urgent {
	background-color: @nord-red;
	text-color: @fg;
}

element normal.active {
	background-color: rgba(136, 192, 208, 0.20);
	text-color: @fg;
}

element alternate.normal {
	background-color: rgba(46, 52, 64, 0.95);
	text-color: @fg;
}

element alternate.urgent {
	background-color: @nord-red;
	text-color: @fg;
}

element alternate.active {
	background-color: rgba(136, 192, 208, 0.20);
	text-color: @fg;
}

element selected.normal {
	background-color: rgba(94, 129, 172, 0.86);
	text-color: @fg;
}

element selected.urgent {
	background-color: rgba(191, 97, 106, 0.90);
	text-color: @fg;
}

element selected.active {
	background-color: rgba(136, 192, 208, 0.92);
	text-color: @fg;
}

element-icon {
	size: 1.5em;
}

element-text {
	vertical-align: 0.5;
	text-color: @fg;
}
